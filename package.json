{
  "name": "onskone-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Onskone - Jeu de devinettes multijoueur",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:shared": "pnpm --filter @onskone/shared watch",
    "build": "pnpm run --recursive build",
    "build:shared": "pnpm --filter @onskone/shared build",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "clean": "pnpm run --recursive clean && rm -rf node_modules",
    "install:all": "pnpm install",
    "typecheck": "pnpm run --recursive typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "onskone",
    "game",
    "multiplayer",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.8.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "socket.io-parser": ">=4.2.7"
    }
  }
}
